#!name=Orange
#!desc=Phiên bản cá nhân hóa bởi Minoscloud
#!author=duyvinh09
#!homepage=https://module-ios.netlify.app
#!tgchannel=https://t.me/tienich
#!moduleUrl=https://raw.githubusercontent.com/Minoscloud/Orange/refs/heads/main/app/Orange.sgmodule
#!icon=https://module-ios.netlify.app/assets/img/shadowrocket.webp
#!howtouse=Shadowrocket
#Shadowrocket Configuration - Orange

[Rule]
AND,((DOMAIN-SUFFIX,googlevideo.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,youtubei.googleapis.com),(PROTOCOL,UDP)),REJECT

[Header Rewrite]
^https?://api.revenuecat.com/.+/(receipts$|subscribers/?(.*?)*$) header-del x-revenuecat-etag
^https?://api.revenuecat.com/.+/(receipts$|subscribers/?(.*?)*$) header-del X-RevenueCat-ETag
http-request ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize$ header-del if-none-match

[Url Rewrite]
# Chặn quảng cáo Google Video
^https?:\/\/[\w-]+\.googlevideo\.com\/(?!(dclk_video_ads|videoplayback\?)).+&oad _ reject-200

# YouTube Ads
^https?:\/\/(www|s)\.youtube\.com\/api\/stats\/ads _ reject-200
^https?:\/\/(www|s)\.youtube\.com\/(pagead|ptracking) _ reject-200
^https?:\/\/s\.youtube\.com\/api\/stats\/qoe\?adcontext _ reject-200

# General Video Ad request
(^https?:\/\/[\w-]+\.googlevideo\.com\/(?!dclk_video_ads).+?)&ctier=L(&.+?),ctier,(.+) $1$2$3 302

[Script]

#Locket
#hostname = api.revenuecat.com, firebaseremoteconfig.googleapis.com
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/Minoscloud/Orange/refs/heads/main/app/Locket-Orange.js, requires-body=true, max-size=-1, timeout=60
deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/Minoscloud/Orange/refs/heads/main/app/deleteHeader.js, timeout=60
locket_rc = type=http-response, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/.+, script-path=https://raw.githubusercontent.com/Minoscloud/Orange/refs/heads/main/app/LocketFeatures.js, requires-body=true, max-size=-1, timeout=60
#locket_rc_us = type=http-request, pattern=^https:\/\/firebaseremoteconfig\.googleapis\.com\/v1\/projects\/locket-4252a\/namespaces\/firebase:fetch, requires-body=1, max-size=0, script-path=https://raw.githubusercontent.com/dinhduyvinh09/AppPre/refs/heads/main/js/Locket_rc_us.js, timeout=10
#************************************#

#RevenueCat
#hostname = api.revenuecat.com
RevenueCatVip = type=http-response, pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/Minoscloud/Orange/refs/heads/main/app/revenuecat.js, requires-body=true, max-size=-1, timeout=60
#RevenueCatDeleteHeader = type=http-request, pattern=^https:\/\/api\.(revenuecat|rc-backup)\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/Minoscloud/Orange/refs/heads/main/app/deleteHeader.js, timeout=60
#************************************#

[MITM]
hostname = %APPEND%, api.revenuecat.com, firebaseremoteconfig.googleapis.com, 